{
  "name": "bike-worcester-squarespace",
  "version": "1.1.23",
  "description": "Scripts and stylesheets for the Bike Worcester Squarespace site",
  "scripts": {
    "prebuild": "rm -rf dist/index.js",
    "dev": "webpack --config webpack.config.js --mode development",
    "build": "webpack --config webpack.config.js --mode production",
    "build-css": "webpack --config webpack.recycling.config.js --mode production",
    "test": "jest",
    "watch": "concurrently -k \"npm run watch-src\" \"npm run serve-src\" \"npm run watch-html\" \"npm run serve-html\"",
    "watch-src": "nodemon --watch src --exec \"npm run dev\" -e js,css & ",
    "watch-html": "browser-sync start --config bs-config.js",
    "serve-src": "pnpm dlx serve -p 3001 dist",
    "serve-html": "pnpm dlx serve html/www.bikeworcester.org.uk",
    "sync": "sh scripts/sync.sh",
    "prepare": "husky",
    "commit-version-change": "git add package.json"
  },
  "keywords": [],
  "author": "Al Pagan <generamics@gmail.com>",
  "license": "ISC",
  "devDependencies": {
    "@babel/preset-env": "^7.26.9",
    "@types/flickity": "^2.2.11",
    "babel-loader": "^9.2.1",
    "concurrently": "^9.1.2",
    "css-loader": "^7.1.2",
    "css-minimizer-webpack-plugin": "^7.0.0",
    "eslint": "^9.20.1",
    "husky": "^9.1.7",
    "mini-css-extract-plugin": "^2.9.2",
    "postcss": "^8.5.2",
    "postcss-loader": "^8.1.1",
    "postcss-preset-env": "^10.1.4",
    "prettier": "^3.5.1",
    "puppeteer": "^23.11.1",
    "sass": "^1.85.0",
    "sass-loader": "^16.0.5",
    "style-loader": "^4.0.0",
    "webpack": "^5.98.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.2.0"
  },
  "prettier": {
    "singleQuote": true,
    "trailingComma": "es5"
  },
  "dependencies": {
    "flickity": "^3.0.0",
    "nodemon": "^3.1.9"
  }
}
