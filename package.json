{
  "name": "bike-worcester-squarespace",
  "version": "1.0.31",
  "description": "Scripts and stylesheets for the Bike Worcester Squarespace site",
  "scripts": {
    "prebuild": "rm -rf dist/index.js",
    "dev": "webpack --config webpack.config.js --mode development",
    "build": "webpack --config webpack.config.js --mode production",
    "test": "jest",
    "browser-sync-init": "browser-sync init",
    "watch": "npm run watch-src & npm run watch-html & npm run serve",
    "watch-src": "nodemon --watch src --exec \"npm run dev\" -e js,scss & pnpm dlx serve -p 3001 dist",
    "watch-html": "browser-sync start --config bs-config.js",
    "serve": "pnpm dlx serve html/www.bikeworcester.org.uk",
    "sync": "sh scripts/sync.sh",
    "prepare": "husky",
    "commit-version-change": "git add package.json"
  },
  "keywords": [],
  "author": "Al Pagan <generamics@gmail.com>",
  "license": "ISC",
  "devDependencies": {
    "@babel/preset-env": "^7.25.4",
    "@types/flickity": "^2.2.11",
    "babel-loader": "^9.2.0",
    "css-loader": "^7.1.2",
    "eslint": "^9.11.1",
    "husky": "^9.1.6",
    "prettier": "^3.3.3",
    "puppeteer": "^23.3.1",
    "sass": "^1.78.0",
    "sass-loader": "^16.0.1",
    "style-loader": "^4.0.0",
    "webpack": "^5.94.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.1.0"
  },
  "prettier": {
    "singleQuote": true,
    "trailingComma": "es5"
  },
  "dependencies": {
    "flickity": "^3.0.0",
    "nodemon": "^3.1.7"
  }
}
